--- !u!114 &1000032
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1000030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b3d9f1c5a7e40289d4b6f8a2c0e1537, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Title: '04 - Match the control'
  _Objective: 'Every pair is mass 1 against mass 5. The CONTROL lanes have real colliders and Unity resolves them. The lane beside or below each one has no colliders at all - that is yours, and it should end up moving the same.'
  _NewThisLevel: 'Top two lanes are head on, stacked so you can compare them straight down; Bottom row is the glancing hit, control on the LEFT and yours on the RIGHT - side by side because the light sphere is thrown out of shot vertically and would otherwise land in the other lane; Same masses, speeds and radii on both sides, the only difference is who does the maths; The light one should be thrown back hard and the heavy one barely disturbed - that is 1/mA + 1/mB; R restarts, H toggles this panel'
  _PanelWidth: 340
  _ScreenMargin: 12
  _ShowOnStart: 1
  _ToggleKey: 22
