--- !u!114 &1000032
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1000030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2e7a04c58d1496f9ac3218e6b7d05f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewtonThirdLawDemo
  Interactions:
  - Label: 1 - 1 kg  vs  1 kg
    Comment: Equal masses. The collision is a mirror image on both sides.
    A:
      Body: {fileID: 1000102}
      Bar: {fileID: 0}
    B:
      Body: {fileID: 1000122}
      Bar: {fileID: 0}
  - Label: 2 - 2 kg  vs  1 kg
    Comment: Blue is twice as heavy, so it moves half as fast, coming and going.
    A:
      Body: {fileID: 1000142}
      Bar: {fileID: 0}
    B:
      Body: {fileID: 1000162}
      Bar: {fileID: 0}
  - Label: 3 - 4 kg  vs  1 kg
    Comment: Four times heavier, a quarter of the speed, same impulse at the impact.
    A:
      Body: {fileID: 1000182}
      Bar: {fileID: 0}
    B:
      Body: {fileID: 1000202}
      Bar: {fileID: 0}
  - Label: 4 - 8 kg  vs  1 kg
    Comment: 'Eight times heavier, so it barely twitches. It still takes the same
      impulse as the small one: that is why a big body only looks like it does not
      react.'
    A:
      Body: {fileID: 1000222}
      Bar: {fileID: 0}
    B:
      Body: {fileID: 1000242}
      Bar: {fileID: 0}
  PushForce: 3
  PushDuration: 1
  PushDirection: {x: 1, y: 0, z: 0}
  RunDuration: 5
  HoldDuration: 3
  RestartKey: 32
  DropBreadcrumbs: 1
  BreadcrumbInterval: 0.5
  BreadcrumbSize: 0.22
  ForceBarScale: 0.3
  ImpulseBarScale: 0.15
  ImpulseBarDuration: 0.6
  BarGap: 0.15
  DisplayGUI: 1
  DisplayGizmos: 1
  ColourA: {r: 0.45, g: 0.5, b: 1, a: 1}
  ColourB: {r: 0.95, g: 0.85, b: 0.3, a: 1}
